{
  "name": "cherry-styled-components",
  "version": "0.2.15",
  "description": "Cherry is a design system for the modern web. Designed in Figma, built in React using Typescript.",
  "private": false,
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "author": "Luan Gjokaj <luan@riangle.com>",
  "homepage": "https://cherry.al",
  "repository": "https://github.com/cherry-design-system/styled-components",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cherry",
    "react",
    "figma",
    "components",
    "ui",
    "css",
    "framework",
    "design",
    "design system",
    "styled-components"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "node scripts/screenshot-previews.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.28.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@swc/plugin-styled-components": "^12.15.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "next": "^16.3.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "sharp": "^0.35.3",
    "styled-components": "^6.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3"
  }
}
